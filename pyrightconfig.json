{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "typeCheckingMode": "basic",
  "extraPaths": [
    "packages/etl-db-writer",
    "packages/indicators",
    "libs/etl-run",
    "libs/verichron-runtime-env",
    "libs/testing",
    "apps",
    "apps/extractors",
    "apps/extractors/ileapp_bridge",
    "apps/extractors/indicator_match"
  ],
  "include": [
    "packages/*",
    "apps/*",
    "libs/*",
    "scripts"
  ],
  "exclude": [
    "tools/ileapp/iLEAPP",
    "**/node_modules",
    "**/.venv",
    "**/dist"
  ]
}