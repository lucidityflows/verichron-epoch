# The administrative identity: Docker's Postgres superuser, used only by
# migrate.py and provision_roles.py (`mise run db`).
DB_USER=
DB_PASSWORD=
# The runtime login the app, orchestrator and stages connect as (EPOCH-562);
# `mise run db` creates it. Must differ from DB_USER.
DB_APP_USER=
DB_APP_PASSWORD=
DB_NAME=
DB_PORT=
DB_HOST=