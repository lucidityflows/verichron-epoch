{
  "description": "Which values a record mentions, by kind, and where they are (EPOCH-581). Each rule names one field of one source and what it holds; a value's shape never decides its kind (measured 2026-10-20 on a real backup: 129 columns had a phone number's shape, most of them coordinates, byte counts and scores). The field's name is the entity's role. Shapes only check a rule: a value that doesn't fit its kind is counted as unreadable, never stored. The Python reader is entity_rules.py; scripts/check_entity_rules.py runs every rule against a real iLEAPP output.",
  "version": 2,
  "kinds": {
    "url": {
      "title": "URL",
      "normalize": "url",
      "also": "domain"
    },
    "domain": {
      "title": "Domain",
      "normalize": "domain"
    },
    "app": {
      "title": "App",
      "normalize": "bundle_id"
    },
    "process": {
      "title": "Process",
      "normalize": "process_name"
    },
    "email": {
      "title": "Email address",
      "normalize": "email"
    },
    "phone": {
      "title": "Phone number",
      "normalize": "phone"
    },
    "wifi_network": {
      "title": "Wi-Fi network",
      "normalize": "ssid"
    },
    "wifi_access_point": {
      "title": "Wi-Fi access point",
      "normalize": "mac"
    },
    "bluetooth_device": {
      "title": "Bluetooth device",
      "normalize": "mac"
    },
    "ip": {
      "title": "IP address",
      "normalize": "ip"
    }
  },
  "declared_types": {
    "phonenumber": "phone"
  },
  "not_covered": {
    "own_wifi_mac": "The phone's own Wi-Fi addresses (WiFi Scanned Networks: MAC Used For Network, Private MAC Computed For Network) are the device itself, not another device or network.",
    "uniform_type_ids": "Type identifiers (public.jpeg, Uniform Type ID, Attachment Type) have a bundle ID's shape but name a file type, not an app.",
    "random_bluetooth_addresses": "A Bluetooth LE address of type Random rotates, so it identifies no device; only Public addresses are read as devices, and Random ones are counted.",
    "phone_numbers_in_text": "A number inside free text is not read as a phone number: in text, digits with a phone number's shape are as often amounts, codes and times. URLs, email addresses and IP addresses have shapes nothing else has, and are read from text.",
    "cookie_values": "A cookie's value is the site's own opaque identifier. Measured on a real backup (2026-10-20), its dotted numbers have an IPv4 address's shape inside longer identifiers; nothing says they are addresses.",
    "note_snippets": "Notes \"Snippet\" is the start of \"Note Contents\", which is read.",
    "pending_research": "Values that carry an identifier inside an Apple-internal format are reviewed under EPOCH-582 before a rule reads them: InteractionC Contacts \"Content URL\", Personalization Portrait \"Group ID\", Photos \"Adjustment Format ID\", Health Source Devices \"Local ID\".",
    "file_urls": "A file URL (file:///…) names a path on the device, not a host, so it is not read as a URL. File paths are not a kind yet.",
    "search_terms_redirects": "Safari Browser - Search Terms' \"Redirect Source\" and \"Redirect Destination\" hold four-digit numbers, not URLs, despite their names: 103 values across two reference backups, every one numeric (checked 2026-10-15, EPOCH-491)."
  },
  "shape_hints": {
    "url": "URL",
    "email": "email address",
    "ipv4": "IPv4 address",
    "phone": "phone number",
    "mac": "MAC address",
    "bundle_id": "bundle ID"
  },
