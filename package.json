{
  "name": "verichron-epoch",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first local desktop forensic client and incident response orchestration engine",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:contracts": "pnpm --filter @verichron/contracts build",
    "sync:contracts": "python3 scripts/sync_contracts.py --write",
    "check:contracts": "python3 scripts/sync_contracts.py --check",
    "format": "prettier --write \"**/*.{ts,tsx,mts}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts}\""
  },
  "devDependencies": {
    "dotenv": "^18.0.8",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "approve-builds": "^1.0.0",
    "node-linker": "^1.0.1"
  }
}