{
  "name": "@verichron/dbserver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @verichron/contracts build && pnpm --filter @verichron/etl-db-reader build",
    "build": "tsc",
    "pretypecheck": "pnpm --filter @verichron/contracts build && pnpm --filter @verichron/etl-db-reader build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "pretest": "pnpm --filter @verichron/contracts build && pnpm --filter @verichron/etl-db-reader build",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@verichron/contracts": "workspace:*",
    "@verichron/etl-db-reader": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
