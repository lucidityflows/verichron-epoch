{
  "name": "@verichron/epoch",
  "productName": "Epoch",
  "version": "0.1.0",
  "description": "Forensic pipeline visualization for verichron",
  "main": ".vite/build/main.js",
  "preload": ".vite/build/preload.js",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clean:ts": "find src/ -type f \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' \\) ! -name 'env.d.ts' -delete",
    "build:contracts": "pnpm --filter @verichron/contracts build",
    "build:db-reader": "pnpm --filter @verichron/db-reader build",
    "prestart": "pnpm run build:contracts && pnpm run build:db-reader",
    "start": "electron-forge start",
    "predev": "pnpm run build:contracts && pnpm run build:db-reader",
    "dev": "electron-forge start",
    "prepackage": "pnpm run build:contracts && pnpm run build:db-reader",
    "package": "electron-forge package",
    "premake": "pnpm run build:contracts && pnpm run build:db-reader",
    "make": "electron-forge make",
    "lint": "eslint .",
    "test": "tsx --test 'src/main/**/*.test.ts'"
  },
  "keywords": [],
  "author": {
    "name": "Robert Torres",
    "email": "vermiliontides@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/intent": "^0.4.0",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.7.0",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "install": "^0.13.0",
    "tailwindcss": "^4.1.8",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "@verichron/contracts": "workspace:*",
    "@verichron/etl-db-reader": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "catalog:",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.37.0",
    "pg": "^8.13.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  }
}
